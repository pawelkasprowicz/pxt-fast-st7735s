ine(\"\")\n    serial.writeLine(\"ALL TESTS FINISHED\")\n\n    basic.showIcon(IconNames.Happy)\n"]]}]}]},{"timestamp":1794257143110,"editorVersion":"9.0.12","changes":[{"type":"edited","filename":"main.blocks","patch":[{"start1":0,"length1":757,"diffs":[[1,"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables></variables><block type=\"pxt-on-start\" x=\"0\" y=\"0\"><statement name=\"HANDLER\"><block type=\"serial_redirect_to_usb\"></block></statement></block><block type=\"device_forever\" x=\"304\" y=\"105\"><statement name=\"HANDLER\"><block type=\"serial_writeline\"><value name=\"text\"><shadow type=\"text\"><field name=\"TEXT\">TEST USB</field></shadow></value><next><block type=\"device_pause\"><value name=\"pause\"><shadow type=\"timePicker\"><field name=\"ms\">1000</field></shadow></value></block></next></block></statement></block></xml>"]]}]},{"type":"edited","filename":"pxt.json","patch":[{"start1":2,"length1":32,"diffs":[[1,"    \"name\": \"ST7735S FAST\",\n"]]},{"start1":235,"length1":44,"diffs":[[1,""]]}]},{"type":"added","filename":"test.ts","value":"// tu są testy; nie będzie to kompilowane, gdy ten pakiet będzie używany jako rozszerzenie.\n"}]}],"snapshots":[{"timestamp":1794253066562,"editorVersion":"9.0.12","text":{"main.blocks":"<xml xmlns=\"http://www.w3.org/1999/xhtml\">\n  <block type=\"pxt-on-start\"></block>\n  <block type=\"device_forever\"></block>\n</xml>","main.ts":"\n","README.md":"","pxt.json":"{\n    \"name\": \"ST7735S FAST\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\",\n        \"microphone\": \"*\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\"\n    ],\n    \"additionalFilePaths\": []\n}\n"}},{"timestamp":1794255038876,"editorVersion":"9.0.12","text":{"main.blocks":"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables></variables><block type=\"pxt-on-start\" x=\"0\" y=\"0\"><statement name=\"HANDLER\"><block type=\"serial_redirect_to_usb\"></block></statement></block><block type=\"device_forever\" x=\"304\" y=\"105\"><statement name=\"HANDLER\"><block type=\"serial_writeline\"><value name=\"text\"><shadow type=\"text\"><field name=\"TEXT\">TEST USB</field></shadow></value><next><block type=\"device_pause\"><value name=\"pause\"><shadow type=\"timePicker\"><field name=\"ms\">1000</field></shadow></value></block></next></block></statement></block></xml>","main.ts":"// ========================================\n// WAVESHARE ST7735S FAST SPI TEST\n// micro:bit V2\n// MakeCode JavaScript\n//\n// A   = spiWrite pojedyncze bajty\n// B   = spiTransfer 64 bajty\n// A+B = spiTransfer 512 bajtow\n//\n// SPI = 8 MHz\n// Wyniki przez USB\n// ========================================\n\n// PINY WAVESHARE\nconst LCD_CS = DigitalPin.P16\nconst LCD_DC = DigitalPin.P12\nconst LCD_RST = DigitalPin.P8\nconst SRAM_CS = DigitalPin.P2\n\n// WYMIARY\nconst W = 160\nconst H = 128\n\n// KOLORY RGB565\nconst RED = 0xF800\nconst GREEN = 0x07E0\nconst BLUE = 0x001F\nconst WHITE = 0xFFFF\n\n// USTAWIENIA\nconst SPI_SPEED = 8000000\nconst REPEATS = 3\n\nlet busy = false\n\n// ========================================\n// KOMUNIKACJA LCD\n// ========================================\n\nfunction lcdCommand(cmd: number) {\n    pins.digitalWritePin(LCD_DC, 0)\n    pins.digitalWritePin(LCD_CS, 0)\n    pins.spiWrite(cmd)\n    pins.digitalWritePin(LCD_CS, 1)\n}\n\nfunction lcdData(data: number) {\n    pins.digitalWritePin(LCD_DC, 1)\n    pins.digitalWritePin(LCD_CS, 0)\n    pins.spiWrite(data)\n    pins.digitalWritePin(LCD_CS, 1)\n}\n\n// ========================================\n// OBSZAR RYSOWANIA\n// ========================================\n\nfunction lcdWindow(\n    x: number,\n    y: number,\n    w: number,\n    h: number\n) {\n    lcdCommand(0x2A)\n    lcdData(0)\n    lcdData(x + 1)\n    lcdData(0)\n    lcdData(x + w)\n\n    lcdCommand(0x2B)\n    lcdData(0)\n    lcdData(y + 2)\n    lcdData(0)\n    lcdData(y + h + 1)\n\n    lcdCommand(0x2C)\n}\n\n// ========================================\n// KOLOR PIKSELA\n// ========================================\n\nfunction testColor(y: number): number {\n    if (y < 32) return RED\n    if (y < 64) return GREEN\n    if (y < 96) return BLUE\n    return WHITE\n}\n\n// ========================================\n// METODA 1 - POJEDYNCZE BAJTY\n// ========================================\n\nfunction drawSingle() {\n    lcdWindow(0, 0, W, H)\n\n    pins.digitalWritePin(LCD_DC, 1)\n    pins.digitalWritePin(LCD_CS, 0)\n\n    for (let y = 0; y < H; y++) {\n        let color = testColor(y)\n        let hi = (color >> 8) & 255\n        let lo = color & 255\n\n        for (let x = 0; x < W; x++) {\n            pins.spiWrite(hi)\n            pins.spiWrite(lo)\n        }\n    }\n\n    pins.digitalWritePin(LCD_CS, 1)\n}\n\n// ========================================\n// METODA 2 i 3 - BUFORY\n// ========================================\n\nfunction drawBuffered(size: number) {\n\n    let tx = pins.createBuffer(size)\n    let rx = pins.createBuffer(size)\n\n    lcdWindow(0, 0, W, H)\n\n    pins.digitalWritePin(LCD_DC, 1)\n    pins.digitalWritePin(LCD_CS, 0)\n\n    // Wysylamy obraz wierszami.\n    // Kazdy piksel zajmuje 2 bajty.\n\n    for (let y = 0; y < H; y++) {\n\n        let color = testColor(y)\n        let hi = (color >> 8) & 255\n        let lo = color & 255\n\n        let bytesLeft = W * 2\n\n        while (bytesLeft > 0) {\n\n            let count = Math.min(size, bytesLeft)\n\n            // Przygotowanie bufora\n            for (let i = 0; i < count; i += 2) {\n                tx[i] = hi\n                tx[i + 1] = lo\n            }\n\n            // Transmisja SPI\n            pins.spiTransfer(tx, rx)\n\n            bytesLeft -= count\n        }\n    }\n\n    pins.digitalWritePin(LCD_CS, 1)\n}\n\n// ========================================\n// INICJALIZACJA LCD\n// ========================================\n\nfunction lcdInit() {\n\n    pins.spiPins(\n        DigitalPin.P15,\n        DigitalPin.P14,\n        DigitalPin.P13\n    )\n\n    pins.spiFormat(8, 0)\n    pins.spiFrequency(SPI_SPEED)\n\n    pins.digitalWritePin(LCD_CS, 1)\n    pins.digitalWritePin(SRAM_CS, 1)\n\n    pins.digitalWritePin(LCD_RST, 1)\n    basic.pause(10)\n\n    pins.digitalWritePin(LCD_RST, 0)\n    basic.pause(20)\n\n    pins.digitalWritePin(LCD_RST, 1)\n    basic.pause(120)\n\n    lcdCommand(0x01)\n    basic.pause(150)\n\n    lcdCommand(0x11)\n    basic.pause(150)\n\n    lcdCommand(0x3A)\n    lcdData(0x05)\n\n    lcdCommand(0x36)\n    lcdData(0xA0)\n\n    lcdCommand(0x29)\n    basic.pause(100)\n}\n\n// ========================================\n// POMIAR\n// ========================================\n\nfunction runTest(method: number) {\n\n    if (busy) return\n    busy = true\n\n    let name = \"\"\n\n    if (method == 1) name = \"SINGLE\"\n    if (method == 2) name = \"BUFFER 64\"\n    if (method == 3) name = \"BUFFER 512\"\n\n    serial.writeLine(\"\")\n    serial.writeLine(\"========================\")\n    serial.writeLine(\"TEST: \" + name)\n    serial.writeLine(\"========================\")\n\n    let total = 0\n    let minimum = 999999\n    let maximum = 0\n\n    basic.clearScreen()\n\n    for (let n = 0; n < REPEATS; n++) {\n\n        // Pomiar czasu\n        let start = input.runningTime()\n\n        if (method == 1) {\n            drawSingle()\n        } else if (method == 2) {\n            drawBuffered(64)\n        } else {\n            drawBuffered(512)\n        }\n\n        let elapsed = input.runningTime() - start\n\n        total += elapsed\n\n        if (elapsed < minimum) minimum = elapsed\n        if (elapsed > maximum) maximum = elapsed\n\n        serial.writeLine(\n            \"Pomiar \" + (n + 1) +\n            \": \" + elapsed + \" ms\"\n        )\n\n        // Przerwa poza pomiarem\n        basic.pause(300)\n    }\n\n    let average = total / REPEATS\n\n    serial.writeLine(\"------------------------\")\n    serial.writeValue(\"average_ms\", average)\n    serial.writeValue(\"minimum_ms\", minimum)\n    serial.writeValue(\"maximum_ms\", maximum)\n\n    serial.writeLine(\"========================\")\n\n    basic.showIcon(IconNames.Yes)\n\n    busy = false\n}\n\n// ========================================\n// PRZYCISKI\n// ========================================\n\ninput.onButtonPressed(Button.A, function () {\n    runTest(1)\n})\n\ninput.onButtonPressed(Button.B, function () {\n    runTest(2)\n})\n\ninput.onButtonPressed(Button.AB, function () {\n    runTest(3)\n})\n\n// ========================================\n// START\n// ========================================\n\nserial.redirectToUSB()\n\nlcdInit()\n\nserial.writeLine(\"\")\nserial.writeLine(\"WAVESHARE ST7735S FAST TEST\")\nserial.writeLine(\"micro:bit V2\")\nserial.writeLine(\"SPI 8 MHz\")\nserial.writeLine(\"160x128 RGB565\")\nserial.writeLine(\"\")\nserial.writeLine(\"A   = SINGLE\")\nserial.writeLine(\"B   = BUFFER 64\")\nserial.writeLine(\"A+B = BUFFER 512\")\nserial.writeLine(\"\")\nserial.writeLine(\"READY\")\n\nbasic.showString(\"GO\")","README.md":"","pxt.json":"{\n    \"name\": \"ST7735S FAST\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\",\n        \"microphone\": \"*\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\"\n    ],\n    \"preferredEditor\": \"tsprj\"\n}\n"}},{"timestamp":1794256892943,"editorVersion":"9.0.12","text":{"main.blocks":"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables></variables><block type=\"pxt-on-start\" x=\"0\" y=\"0\"><statement name=\"HANDLER\"><block type=\"serial_redirect_to_usb\"></block></statement></block><block type=\"device_forever\" x=\"304\" y=\"105\"><statement name=\"HANDLER\"><block type=\"serial_writeline\"><value name=\"text\"><shadow type=\"text\"><field name=\"TEXT\">TEST USB</field></shadow></value><next><block type=\"device_pause\"><value name=\"pause\"><shadow type=\"timePicker\"><field name=\"ms\">1000</field></shadow></value></block></next></block></statement></block></xml>","main.ts":"fastLCD.pixel(20, 30, fastLCD.Color.Red)\nfastLCD.line(0, 0, 100, 80, fastLCD.Color.Green)\nfastLCD.text(10, 10, \"HELLO\", fastLCD.Color.White)","README.md":"","pxt.json":"{\n    \"name\": \"ST7735S FAST\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\",\n        \"microphone\": \"*\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\"\n    ],\n    \"preferredEditor\": \"tsprj\"\n}\n"}}],"shares":[],"lastSaveTime":1794257577786}