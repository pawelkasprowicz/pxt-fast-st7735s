{"entries":[{"timestamp":1794253066563,"editorVersion":"9.0.12","changes":[{"type":"edited","filename":"main.blocks","patch":[{"start1":0,"length1":185,"diffs":[[1,"<xml xmlns=\"http://www.w3.org/1999/xhtml\">\n  <block type=\"pxt-on-start\"></block>\n  <block type=\"device_forever\"></block>\n</xml>"]]}]},{"type":"edited","filename":"main.ts","patch":[{"start1":0,"length1":64,"diffs":[[1,""]]},{"start1":1,"length1":2558,"diffs":[[1,""]]}]},{"type":"edited","filename":"pxt.json","patch":[{"start1":235,"length1":31,"diffs":[[1,"    \"additionalFilePaths\": []\n"]]}]}]},{"timestamp":1794253282325,"editorVersion":"9.0.12","changes":[{"type":"edited","filename":"main.ts","patch":[{"start1":0,"length1":0,"diffs":[[1,"// WAVESHARE ST7735S FAST\n// micro:bit V2\n// TEST SZYBKOSCI SPI\n\nconst LCD_CS = DigitalPin.P16\nconst LCD_DC = DigitalPin.P12\nconst LCD_RST = DigitalPin.P8\n\nconst BLACK = 0x0000\nconst WHITE = 0xFFFF\nconst RED = 0xF800\nconst GREEN = 0x07E0\nconst BLUE = 0x001F\n\nfunction lcdCommand(cmd: number) {\n    pins.digitalWritePin(LCD_DC, 0)\n    pins.digitalWritePin(LCD_CS, 0)\n    pins.spiWrite(cmd)\n    pins.digitalWritePin(LCD_CS, 1)\n}\n\nfunction lcdData(data: number) {\n    pins.digitalWritePin(LCD_DC, 1)\n    pins.digitalWritePin(LCD_CS, 0)\n    pins.spiWrite(data)\n    pins.digitalWritePin(LCD_CS, 1)\n}\n\nfunction lcdWindow(x: number, y: number, w: number, h: number) {\n    lcdCommand(0x2A)\n    lcdData(0)\n    lcdData(x + 1)\n    lcdData(0)\n    lcdData(x + w)\n\n    lcdCommand(0x2B)\n    lcdData(0)\n    lcdData(y + 2)\n    lcdData(0)\n    lcdData(y + h + 1)\n\n    lcdCommand(0x2C)\n}\n\nfunction fillRect(\n    x: number,\n    y: number,\n    w: number,\n    h: number,\n    color: number\n) {\n    if (w <= 0 || h <= 0) return\n\n    lcdWindow(x, y, w, h)\n\n    let hi = (color >> 8) & 255\n    let lo = color & 255\n\n    pins.digitalWritePin(LCD_DC, 1)\n    pins.digitalWritePin(LCD_CS, 0)\n\n    for (let i = 0; i < w * h; i++) {\n        pins.spiWrite(hi)\n        pins.spiWrite(lo)\n    }\n\n    pins.digitalWritePin(LCD_CS, 1)\n}\n\nfunction lcdInit() {\n    pins.spiPins(\n        DigitalPin.P15,\n        DigitalPin.P14,\n        DigitalPin.P13\n    )\n\n    pins.spiFormat(8, 0)\n    pins.spiFrequency(8000000)\n\n    pins.digitalWritePin(LCD_CS, 1)\n\n    pins.digitalWritePin(LCD_RST, 1)\n    basic.pause(10)\n    pins.digitalWritePin(LCD_RST, 0)\n    basic.pause(20)\n    pins.digitalWritePin(LCD_RST, 1)\n    basic.pause(120)\n\n    lcdCommand(0x01)\n    basic.pause(150)\n\n    lcdCommand(0x11)\n    basic.pause(150)\n\n    lcdCommand(0x3A)\n    lcdData(0x05)\n\n    lcdCommand(0x36)\n    lcdData(0xA0)\n\n    lcdCommand(0x29)\n    basic.pause(100)\n}\n\n// Pomiar czasu w milisekundach\nfunction testSPI(\n    frequency: number,\n    color: number\n) {\n    pins.spiFrequency(frequency)\n\n    basic.clearScreen()\n    basic.showString(\"F\")\n    basic.showNumber(frequency / 1000000)\n\n    // Krotka przerwa przed pomiarem\n    basic.pause(500)\n\n    let start = input.runningTime()\n\n    fillRect(0, 0, 160, 128, color)\n\n    let elapsed = input.runningTime() - start\n\n    // Pokaz wynik na micro:bicie\n    basic.showString(\"T\")\n    basic.showNumber(elapsed)\n\n    basic.pause(1500)\n}\n\n// PROGRAM GLOWNY\n\nlcdInit()\n\nbasic.showString(\"START\")\n\n// Test 4 MHz\ntestSPI(4000000, RED)\n\n// Test 8 MHz\ntestSPI(8000000, GREEN)\n\n// Test 16 MHz\ntestSPI(16000000, BLUE)\n\n// Koniec\nbasic.showIcon(IconNames.Yes)"]]}]}]},{"timestamp":1794253886094,"editorVersion":"9.0.12","changes":[{"type":"edited","filename":"main.ts","patch":[{"start1":0,"length1":2789,"diffs":[[1,""]]}]}]},{"timestamp":1794253886830,"editorVersion":"9.0.12","changes":[{"type":"edited","filename":"main.blocks","patch":[{"start1":0,"length1":575,"diffs":[[1,"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables></variables><block type=\"pxt-on-start\" x=\"20\" y=\"20\"></block><block type=\"device_forever\" x=\"257\" y=\"20\"></block></xml>"]]}]},{"type":"edited","filename":"main.ts","patch":[{"start1":0,"length1":106,"diffs":[[1,"// WAVESHARE ST7735S FAST\n// micro:bit V2\n// TEST SPI + STOPER A/B\n\nconst LCD_CS = DigitalPin.P16\nconst LCD_DC = DigitalPin.P12\nconst LCD_RST = DigitalPin.P8\n\nconst WHITE = 0xFFFF\nconst RED = 0xF800\nconst GREEN = 0x07E0\nconst BLUE = 0x001F\n\nlet stoperStart = 0\nlet stoperWynik = 0\nlet stoperDziala = false\n\n// Wyslij komende\nfunction lcdCommand(cmd: number) {\n    pins.digitalWritePin(LCD_DC, 0)\n    pins.digitalWritePin(LCD_CS, 0)\n    pins.spiWrite(cmd)\n    pins.digitalWritePin(LCD_CS, 1)\n}\n\n// Wyslij dane\nfunction lcdData(data: number) {\n    pins.digitalWritePin(LCD_DC, 1)\n    pins.digitalWritePin(LCD_CS, 0)\n    pins.spiWrite(data)\n    pins.digitalWritePin(LCD_CS, 1)\n}\n\n// Ustaw obszar\nfunction lcdWindow(x: number, y: number, w: number, h: number) {\n    lcdCommand(0x2A)\n    lcdData(0)\n    lcdData(x + 1)\n    lcdData(0)\n    lcdData(x + w)\n\n    lcdCommand(0x2B)\n    lcdData(0)\n    lcdData(y + 2)\n    lcdData(0)\n    lcdData(y + h + 1)\n\n    lcdCommand(0x2C)\n}\n\n// Wypelnij prostokat\nfunction fillRect(\n    x: number,\n    y: number,\n    w: number,\n    h: number,\n    color: number\n) {\n    if (w <= 0 || h <= 0) return\n\n    lcdWindow(x, y, w, h)\n\n    let hi = (color >> 8) & 255\n    let lo = color & 255\n\n    pins.digitalWritePin(LCD_DC, 1)\n    pins.digitalWritePin(LCD_CS, 0)\n\n    for (let i = 0; i < w * h; i++) {\n        pins.spiWrite(hi)\n        pins.spiWrite(lo)\n    }\n\n    pins.digitalWritePin(LCD_CS, 1)\n}\n\n// Inicjalizacja LCD\nfunction lcdInit() {\n    pins.spiPins(\n        DigitalPin.P15,\n        DigitalPin.P14,\n        DigitalPin.P13\n    )\n\n    pins.spiFormat(8, 0)\n    pins.spiFrequency(8000000)\n\n    pins.digitalWritePin(LCD_CS, 1)\n\n    pins.digitalWritePin(LCD_RST, 1)\n    basic.pause(10)\n    pins.digitalWritePin(LCD_RST, 0)\n    basic.pause(20)\n    pins.digitalWritePin(LCD_RST, 1)\n    basic.pause(120)\n\n    lcdCommand(0x01)\n    basic.pause(150)\n\n    lcdCommand(0x11)\n    basic.pause(150)\n\n    lcdCommand(0x3A)\n    lcdData(0x05)\n\n    lcdCommand(0x36)\n    lcdData(0xA0)\n\n    lcdCommand(0x29)\n    basic.pause(100)\n}\n\n// PRZYCISK A - START\ninput.onButtonPressed(Button.A, function () {\n    stoperStart = input.runningTime()\n    stoperWynik = 0\n    stoperDziala = true\n\n    basic.showIcon(IconNames.Yes)\n"]]},{"start1":2221,"length1":0,"diffs":[[1,"\n// PRZYCISK B - STOP\ninput.onButtonPressed(Button.B, function () {\n    if (stoperDziala) {\n        stoperWynik = input.runningTime() - stoperStart\n        stoperDziala = false\n\n        basic.showString(\"T\")\n        basic.showNumber(stoperWynik)\n    }\n})\n\n// PROGRAM GLOWNY\n\nlcdInit()\n\nfillRect(0, 0, 160, 128, WHITE)\n\n// Pokaz gotowosc\nbasic.showString(\"A\")\n\n// Test kolorow przy uruchomieniu\nfillRect(10, 10, 50, 30, RED)\nfillRect(70, 10, 50, 30, GREEN)\nfillRect(10, 50, 50, 30, BLUE)\n\n// Stoper czeka na przycisk A\nbasic.forever(function () {\n    basic.pause(20)\n})"]]}]},{"type":"edited","filename":"pxt.json","patch":[{"start1":235,"length1":35,"diffs":[[1,"    \"preferredEditor\": \"tsprj\"\n"]]}]}]},{"timestamp":1794254380315,"editorVersion":"9.0.12","changes":[{"type":"edited","filename":"main.ts","patch":[{"start1":0,"length1":5899,"diffs":[[1,""]]},{"start1":23,"length1":376,"diffs":[[1,"basic.forever(function () {\n    serial.writeLine(\"TEST USB\")\n    basic.pause(1000)\n})\n"]]}]},{"type":"edited","filename":"pxt.json","patch":[{"start1":235,"length1":31,"diffs":[[1,"    \"preferredEditor\": \"blocksprj\"\n"]]}]}]},{"timestamp":1794254799066,"editorVersion":"9.0.12","changes":[{"type":"edited","filename":"main.ts","patch":[{"start1":0,"length1":105,"diffs":[[1,"// ========================================\n// WAVESHARE ST7735S FAST SPI TEST\n"]]},{"start1":95,"length1":60,"diffs":[[1,"// MakeCode JavaScript\n//\n// A   = spiWrite pojedyncze bajt