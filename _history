ial.writeLine(\"================================\")\nserial.writeLine(\"\")\nserial.writeLine(\"SPEEDS:\")\nserial.writeLine(\"1 / 2 / 4 / 8 / 16 / 32 MHz\")\nserial.writeLine(\"\")\nserial.writeLine(\"A   = FULL SCREEN\")\nserial.writeLine(\"B   = RGB STRIPES\")\nserial.writeLine(\"A+B = ALL TESTS\")\nserial.writeLine(\"\")\nserial.writeLine(\"READY\")\n\nbasic.showString(\"GO\")"]]}]}]},{"timestamp":1794256893739,"editorVersion":"9.0.12","changes":[{"type":"edited","filename":"main.ts","patch":[{"start1":0,"length1":164,"diffs":[[1,"// ============================================\n// SRAM 23LC1024 - SPI SPEED BENCHMARK\n// micro:bit V2 + Waveshare ST7735S\n// ============================================\n"]]},{"start1":172,"length1":84,"diffs":[[1,"// Piny\n"]]},{"start1":208,"length1":0,"diffs":[[1,"let LCD_CS = DigitalPin.P16\n"]]},{"start1":237,"length1":74,"diffs":[[1,"// Prędkości SPI\nlet speeds = [\n    1000000,\n    2000000,\n    4000000,\n    8000000,\n    16000000,\n    32000000\n]\n"]]},{"start1":351,"length1":62,"diffs":[[1,"// Bufory\nlet tx = pins.createBuffer(256)\nlet rx = pins.createBuffer(256)\n"]]},{"start1":426,"length1":80,"diffs":[[1,"// --------------------------------------------\n// Wybór urządzenia\n// --------------------------------------------\n"]]},{"start1":543,"length1":299,"diffs":[[1,"function sramSelect() {\n    pins.digitalWritePin(LCD_CS, 1)\n    pins.digitalWritePin(SRAM_CS, 0)\n"]]},{"start1":643,"length1":61,"diffs":[[1,"function sramDeselect() {\n"]]},{"start1":709,"length1":115,"diffs":[[1,"// --------------------------------------------\n// Ustawienia SPI\n// --------------------------------------------\n"]]},{"start1":824,"length1":184,"diffs":[[1,"function spiSpeed(speed: number) {\n    pins.spiFrequency(speed)\n    pins.spiFormat(8, 0)\n"]]},{"start1":916,"length1":187,"diffs":[[1,"// --------------------------------------------\n// Zapis do SRAM\n// --------------------------------------------\n"]]},{"start1":1030,"le